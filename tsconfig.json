{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "include": [
    "src",
    "custom.d.ts"
  ],
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-native",
    "baseUrl": "./",
    "paths": {
      "@assets/*": [
        "src/assets/*"
      ],
      "@routes/*": [
        "src/routes/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@constants/*": [
        "src/constants/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
     
    }
  }
}
